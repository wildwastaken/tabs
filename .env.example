NETLIFY_DATABASE_URL=
# Optional unpooled URL for tooling/migrations if needed
NETLIFY_DATABASE_URL_UNPOOLED=

# Optional: set this (for example, to "qoheleth") to require a delete password.
TABS_DELETE_PASSWORD=

# Optional server-side secret: full Discord webhook URL for publish logs.
# Leave blank to disable notifications. Never use a NEXT_PUBLIC_ prefix.
DISCORD_PUBLISH_WEBHOOK_URL=
