{
  "name": "tabs-desktop",
  "productName": "tabs",
  "version": "1.0.0",
  "description": "Mac app for tabs that loads Ultimate Guitar songs from your own connection",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.allenliu.tabs",
    "productName": "tabs",
    "files": [
      "main.js",
      "preload.js"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}
